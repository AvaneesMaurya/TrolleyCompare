type ProductComparisonResponse {
    storeName: String
    productName: String
    storePackageQuantity: Float
    storePackageUnit: String
    calculatedRegularPrice: Float
    calculatedClubPrice: Float
}

input ItemInput {
    name: String!
    quantity: Float!
    unit: String!
}

type BasketItemResult {
    productName: String
    storePackageQuantity: Float
    storePackageUnit: String
    calculatedRegularPrice: Float
    calculatedClubPrice: Float
}

type StoreBasketComparison {
    storeName: String
    totalRegularPrice: Float
    totalClubPrice: Float
    items: [BasketItemResult]
}

type Query {
    compareProduct(name: String!, quantity: Float!, unit: String!): [ProductComparisonResponse]
    compareBasket(items: [ItemInput!]!): [StoreBasketComparison]
}